{
  "name": "deckling",
  "version": "0.1.0",
  "description": "A tiny AI companion that lives in your Steam Deck",
  "type": "module",
  "scripts": {
    "build": "rollup -c",
    "watch": "rollup -c -w",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src --max-warnings 0",
    "test": "python3 -m pytest -q"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SMwaterSHLDhelp/Deckling.git"
  },
  "keywords": [
    "decky",
    "plugin",
    "steam-deck",
    "ai",
    "chat"
  ],
  "author": "SOMEwaterSHOULDhelp",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/SMwaterSHLDhelp/Deckling/issues"
  },
  "homepage": "https://github.com/SMwaterSHLDhelp/Deckling#readme",
  "devDependencies": {
    "@decky/rollup": "^1.0.2",
    "@decky/ui": "^4.11.0",
    "@rollup/rollup-linux-x64-musl": "^4.53.3",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "eslint": "^10.11.0",
    "globals": "^17.13.0",
    "rollup": "^4.53.3",
    "@typescript/native": "npm:typescript@^7.0.2",
    "typescript": "npm:@typescript/typescript6@^6.0.2",
    "typescript-eslint": "^8.18.0"
  },
  "dependencies": {
    "@decky/api": "^1.1.3",
    "react-icons": "^5.3.0",
    "tslib": "^2.7.0"
  },
  "pnpm": {
    "peerDependencyRules": {
      "ignoreMissing": [
        "react",
        "react-dom"
      ]
    },
    "supportedArchitectures": {
      "os": [
        "linux"
      ],
      "cpu": [
        "x64"
      ],
      "libc": [
        "glibc",
        "musl"
      ]
    }
  },
  "packageManager": "pnpm@9.15.9"
}
